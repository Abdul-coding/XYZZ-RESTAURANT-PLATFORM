NODE_ENV=development
APP_PORT=3000
# Use your local Postgres credentials (or run via docker-compose).
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/xyzz?schema=public
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENT_DEMO_MODE=true
# Public customer web app. Printed table QRs encode {CUSTOMER_APP_URL}/t/{qrToken}.
CUSTOMER_APP_URL=https://xyzz.com
